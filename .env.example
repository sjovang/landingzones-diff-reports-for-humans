AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
COMPARISON_QUEUE_NAME=report-jobs
# Optional for the scheduled/manual release sync only. Page loads and comparisons do not call the GitHub API.
# Never expose this token to the browser.
# GITHUB_TOKEN=
# Functions timer uses six-field NCRONTAB, in UTC; default is hourly.
RELEASE_SYNC_SCHEDULE=0 0 * * * *
